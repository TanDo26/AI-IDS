{
	admin off
	servers {
		# Requests arrive from cloudflared (or the host's port forward) on a private Docker address.
		# Trust their client-address headers: Cloudflare sets Cf-Connecting-Ip itself, so a browser
		# can't fake it. Without this every visitor would share cloudflared's address, and with it
		# the per-address sign-in and sign-up limits.
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
		trusted_proxies_strict
	}
}

# One origin: /api/* goes to FastAPI, everything else to the Next.js frontend (plan §C.1, §E)
:80 {
	# Uploads are capped at 100 MB (Cloudflare Free's limit); the API checks again.
	# max_size only fails once that much has been read (e.g. a body without Content-Length)...
	request_body {
		max_size 100MB
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "frame-ancestors 'none'"
		-Server
	}

	handle /api/* {
		# ...so a body announced as too large is refused here, before anything is sent to the API.
		# 100065536 = 100 MB of file + 64 KiB of multipart framing, as in src/api/uploads/router.py
		@too_large expression `{http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > 100065536`
		header @too_large Content-Type application/json
		respond @too_large `{"detail":"Uploads are limited to 100 MB"}` 413 {
			close
		}

		reverse_proxy api:8000 {
			header_up X-Request-ID {http.request.uuid}
			# One address, the visitor's: uvicorn reads the first entry
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Build output: content-hashed file names, safe to cache anywhere for good
	handle /_next/static/* {
		reverse_proxy web:3000
	}

	# Everything else is the Next.js frontend (web/). Next marks prerendered pages
	# `s-maxage=31536000`; a CDN keeping them would serve, after a redeploy, pages whose
	# chunk files no longer exist. Browsers and Cloudflare must check back instead.
	handle {
		reverse_proxy web:3000 {
			header_down Cache-Control "no-cache"
		}
	}
}

# Container healthcheck only (not published): answers without involving the API or the frontend
:8081 {
	respond "ok"
}
