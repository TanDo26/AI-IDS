{
	admin off
}

# One origin: /api/* goes to FastAPI, everything else to the frontend (plan §C.1)
:80 {
	# Uploads are capped at 100 MB (Cloudflare Free's limit); the API checks again
	request_body {
		max_size 100MB
	}

	handle /api/* {
		reverse_proxy api:8000 {
			header_up X-Request-ID {http.request.uuid}
		}
	}

	# Replaced by `reverse_proxy web:3000` when the frontend lands (Stage E)
	handle {
		respond "AI-IDS: frontend not deployed yet. API docs: /api/docs" 200
	}
}
