# AI-IDS web stack settings. Copy to .env (git-ignored) and fill in the secrets:
#   cp .env.example .env
# Docker Compose reads this file, and so does the API when run on the host (src/api/settings.py).

# ── Required for anything but local experiments ─────────────
# production refuses to start with a default or short IDS_SECRET_KEY
IDS_ENV=development
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"   (at least 32 bytes)
IDS_SECRET_KEY=change-me

# Postgres container (Compose builds IDS_DATABASE_URL from these)
POSTGRES_USER=ids
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ids

# ── Only when running the API on the host (Compose sets these itself) ──
# IDS_DATABASE_URL=postgresql+psycopg://ids:change-me@localhost:5432/ids
# IDS_REDIS_URL=redis://localhost:6379/0
# IDS_MODEL_STORE=./model_store
# IDS_DATA_DIR=./data

# ── Optional (defaults shown) ───────────────────────────────
# IDS_MAX_UPLOAD_MB=100              # decimal MB; Cloudflare Free caps request bodies at 100 MB
# IDS_RETENTION_DAYS=30              # raw uploads are deleted after this; results and usage stay
# IDS_ENABLE_PCAP=false              # until the flow extractor (Stage D) passes its parity test
# IDS_MODEL_POLL_SECONDS=30          # fallback check of the active model when Redis events are missed
# IDS_MODEL_EVENTS_ENABLED=true      # Redis pub/sub for immediate model switches
# IDS_DISK_WARNING_PERCENT=85        # /admin/server warns above this data-volume usage
# IDS_METRICS_ENABLED=true           # GET /metrics for Prometheus (not routed by Caddy)
# IDS_COOKIE_SECURE=true             # false only for plain-http access from another machine
# IDS_RATE_LIMITS_ENABLED=true
# IDS_ACCESS_TOKEN_MINUTES=15
# IDS_REFRESH_TOKEN_DAYS=7
